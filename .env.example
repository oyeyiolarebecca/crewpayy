# Blaaiz Platform API Configuration
# Get your Client ID and Secret from the Blaaiz Developer Dashboard (API & Webhooks)
BLAAIZ_CLIENT_ID=""
BLAAIZ_CLIENT_SECRET=""
BLAAIZ_ENV="sandbox" # "sandbox" or "production"
# Override only when your Blaaiz account uses a custom API host or resource paths.
